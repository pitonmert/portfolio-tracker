{
  "name": "portfolio-tracker-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier . --write --log-level warn",
    "format:check": "prettier . --check --log-level warn",
